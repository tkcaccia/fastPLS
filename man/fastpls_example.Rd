\name{fastpls_example}
\alias{fastpls_example}
\docType{data}
\title{Synthetic Biomedical Classification Example}
\usage{
data(fastpls_example)
}
\format{
A list with five elements:
\describe{
\item{\code{X_train}}{Numeric training matrix with 90 samples and 40
features.}
\item{\code{y_train}}{Balanced two-level training factor with levels
\code{"reference"} and \code{"case"}.}
\item{\code{X_test}}{Numeric test matrix with 30 samples and the same 40
features.}
\item{\code{y_test}}{Balanced two-level test factor.}
\item{\code{feature_names}}{Character vector containing the 40 synthetic
feature names.}
}
}
\description{
A deterministic synthetic dataset for demonstrating high-dimensional
classification with correlated predictors. Three latent variables generate
the correlated feature matrix, and the first eight features contain an
additional class-associated shift. The object provides a fixed, class-balanced
training and test split and contains no participant or third-party data.
}
\source{
Generated by the fastPLS package script
\file{data-raw/generate_fastpls_example.R}.
}
\examples{
data(fastpls_example)
dim(fastpls_example$X_train)
table(fastpls_example$y_train)

fit <- pls(
    fastpls_example$X_train,
    fastpls_example$y_train,
    fastpls_example$X_test,
    fastpls_example$y_test,
    ncomp = 1:2,
    method = "simpls",
    backend = "cpu",
    seed = 42
)
fit$accuracy
}
\keyword{datasets}
